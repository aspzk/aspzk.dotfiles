/**
 * neutral-dark.rasi
 */

* {
    bg0:        #000000;
    bg1:        #121212;
    bg2:        #FFFFFF;
    fg0:        #FFFFFF;
    fg1:        #FFFFFF;
    fg2:        #FFFFFF;
    accent:     #FFFFFF;

    font: "Iosevka Nerd Font 13";     
    background-color: transparent;
    text-color:       @fg0;
}

window {
    background-color: @bg0;
    border:           1px;
    border-color:     @bg2;
    border-radius:    0px;
    width:            520px;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
}

inputbar {
    background-color: @bg0;
    border:           0px 0px 1px 0px;
    border-color:     @bg1;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @fg2;
    padding:          0px 4px 0px 0px;
}

entry {
    background-color: transparent;
    text-color:       @fg0;
    placeholder:      "buscar...";
    placeholder-color: @fg2;
    cursor:           text;
}

listview {
    background-color: transparent;
    padding:          6px 0px;
    lines:            8;
    scrollbar:        false;
    spacing:          0px;
}

element {
    background-color: transparent;
    text-color:       @fg1;
    padding:          8px 16px;
    spacing:          10px;
    border-radius:    0px;
    orientation:      horizontal;
}

element selected {
    background-color: @bg1;
    text-color:       @fg0;
}

element-icon {
    background-color: transparent;
    size:             18px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

